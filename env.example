# ============================================================
# Credenciais e identificadores da aplicação de controle de despesas.
# Copie este arquivo para um novo arquivo chamado ".env" (sem extensão .example)
# na mesma pasta, e preencha os valores abaixo.
#
# IMPORTANTE: o arquivo ".env" (o real, com seus dados preenchidos) contém
# segredos — nunca compartilhe ele nem suba pra um repositório Git público.
# Se usar Git, adicione uma linha ".env" no arquivo .gitignore.
#
# Pra rodar isso com OUTRA conta/planilha no futuro, basta criar um .env
# diferente com os valores da outra conta — o código não muda.
# ============================================================

# --- Pluggy (acesso aos dados bancários do Itaú) ---

# CLIENT ID e CLIENT SECRET da sua aplicação no Pluggy.
# Onde conseguir: https://dashboard.pluggy.ai -> sua Aplicação -> Credenciais.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# ID da conexão (item) entre sua conta bancária e a aplicação Pluggy.
# Onde conseguir: depois de conectar sua conta via Meu Pluggy (meu.pluggy.ai)
# e vincular pela aplicação "Demo" do dashboard, o Item ID aparece no menu
# de três pontinhos ("Copiar Item ID") na tela de conexão bem-sucedida.
PLUGGY_ITEM_ID=

# --- Google Sheets (planilha de controle de despesas) ---

# ID da planilha do Google Sheets onde as despesas são gravadas.
# Onde conseguir: é o trecho da URL da planilha entre "/d/" e "/edit".
# Ex: https://docs.google.com/spreadsheets/d/ESSE_TRECHO_AQUI/edit
GOOGLE_SPREADSHEET_ID=

# Caminho (relativo ou absoluto) pro arquivo .json da chave da Service Account
# do Google Cloud, usada pra ler/escrever na planilha sem precisar de login interativo.
# Onde conseguir: Google Cloud Console -> IAM e administrador -> Contas de
# serviço -> [sua conta] -> aba "Chaves" -> "Adicionar chave" -> JSON.
# IMPORTANTE: a planilha também precisa ser compartilhada (permissão de Editor)
# com o e-mail dessa conta de serviço (campo "client_email" dentro do JSON).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json
